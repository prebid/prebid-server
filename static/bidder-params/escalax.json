{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Escalax Adapter Params",
    "description": "A schema which validates params accepted by the Escalax adapter",
    "type": "object",
    "properties": {
        "accountId": {
            "type": "string",
            "description": "Account id (exchange integration)",
            "minLength": 1
        },
        "sourceId": {
            "type": "string",
            "description": "Source id (exchange integration)",
            "minLength": 1
        },
        "supplyPlacementId": {
            "type": "string",
            "description": "Supply placement id (SSP integration)",
            "minLength": 1
        },
        "region": {
            "type": "string",
            "description": "Optional region override, shared by both integrations. Defaults to us.",
            "enum": [
                "us",
                "eu",
                "apac"
            ]
        }
    },
    "oneOf": [
        {
            "required": [
                "accountId",
                "sourceId"
            ]
        },
        {
            "required": [
                "supplyPlacementId"
            ]
        }
    ]
}