{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Growzee Adapter Params",
  "description": "A schema which validates params accepted by the Growzee adapter",
  "type": "object",
  "properties": {
    "publisherId": {
      "type": "string",
      "description": "Publisher ID (UUID) provided by Growzee",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  },
  "required": ["publisherId"]
}
