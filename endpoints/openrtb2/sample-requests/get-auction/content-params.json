  "expectedReturnCode": 200,
  "expectedBidResponse": {
    "id": "test-get-uuid-content",
    "seatbid": [
      {
        "bid": [
          {"id": "appnexus-bid", "impid": "imp1", "price": 1.50}
        ],
        "seat": "appnexus"
      }
    ],
    "cur": "USD"
  }
