          "maxseq": 3,
          "poddur": 60,
          "protocols": [2, 3],
          "w": 640,
          "h": 360,
          "podid": "pod-alpha",
          "podseq": 1,
          "placement": 2,
          "plcmt": 1,
          "linearity": 1,
          "skip": 1,
          "skipmin": 2,
          "skipafter": 5,
          "sequence": 1,
          "slotinpod": 2,
          "mincpmpersec": 1.25,
          "battr": [1, 2],
          "maxextended": 5,
          "minbitrate": 100,
          "maxbitrate": 1000,
          "boxingallowed": 0,
          "playbackmethod": [1, 2],
          "playbackend": 2,
