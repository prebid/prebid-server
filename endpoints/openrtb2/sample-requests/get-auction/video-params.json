{
  "description": "GET video: explicit mtype=2 with all video params written to correct OpenRTB destinations; stored banner is removed",
  "httpMethod": "GET",
  "query": "srid=stored-video&mtype=2&mindur=5&maxdur=30&w=640&h=360&api=2,7&battr=1,2&delivery=1,2&linearity=1&minbr=100&maxbr=1000&maxex=5&maxseq=3&mincpms=1.25&poddur=60&podid=pod-alpha&podseq=1&proto=2,3&seq=1&slotinpod=2&startdelay=-1&skip=1&skipafter=5&skipmin=2&pos=1&placement=2&plcmt=1&playbackend=2&playbackmethod=1,2&boxingallowed=0&mimes=video%2Fmp4,video%2Fwebm&page=https://example.com",
  "generatedRequestId": "test-get-uuid-video-params",
