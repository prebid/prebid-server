{
  "description": "req.user.id=u1 with a stored user.data array: non-array path sets user.id, user.data is preserved",
  "query": "srid=testid&req.user.id=u1",
  "stored_bid_request": {
    "site": {"page": "https://example.com"},
    "user": {"data": [{"id": "seg-orig"}]},
    "imp": [{"id": "imp1"}]
  },
  "expected_bid_request": {
    "site": {"page": "https://example.com"},
    "user": {"id": "u1", "data": [{"id": "seg-orig"}]},
    "imp": [{"id": "imp1"}],
    "ext": {
      "prebid": {
        "storedrequest": {"id": "testid"},
        "server": {"http_method": "GET"}
      }
    }
  }
