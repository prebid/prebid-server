{
  "expectedMakeRequestsErrors": [
    {
      "value": "invalid imp.ext.bidder for imp imp-bad:.*",
      "comparison": "regex"
    }
  ],
  "mockBidRequest": {
    "id": "test-request-id",
    "imp": [
      {
        "id": "imp-bad",
        "banner": { "format": [{ "w": 300, "h": 250 }] },
        "ext": { "bidder": "not-an-object" }
      },
      {
        "id": "imp-good",
        "banner": { "format": [{ "w": 300, "h": 250 }] },
        "ext": { "bidder": { "seat": "seat-eu", "region": "eu" } }
      }
    ],
    "site": { "id": "271", "domain": "example.com" }
  },
  "httpCalls": [
    {
      "expectedRequest": {
        "uri": "https://eu.floxis.tech/pbs?seat=seat-eu",
        "body": {
          "id": "test-request-id",
          "imp": [
            {
              "id": "imp-good",
              "banner": { "format": [{ "w": 300, "h": 250 }] },
              "ext": { "bidder": { "seat": "seat-eu", "region": "eu" } }
            }
          ],
          "site": { "id": "271", "domain": "example.com" }
        },
        "impIDs": ["imp-good"]
      },
      "mockResponse": {
        "status": 200,
        "body": {
          "id": "test-request-id",
          "cur": "EUR",
          "seatbid": [
            {
              "seat": "floxis",
              "bid": [
                { "id": "1", "impid": "imp-good", "price": 1.0, "adm": "<div>ad</div>", "crid": "c1", "mtype": 1 }
              ]
            }
          ]
        }
      }
    }
  ],
  "expectedBidResponses": [
    {
      "currency": "EUR",
      "bids": [
        {
          "bid": { "id": "1", "impid": "imp-good", "price": 1.0, "adm": "<div>ad</div>", "crid": "c1", "mtype": 1 },
          "type": "banner"
        }
      ]
    }
  ]
}
