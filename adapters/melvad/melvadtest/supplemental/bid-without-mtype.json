        "body": {
          "id": "test-request-id",
          "imp": [
            {
              "id": "video-imp",
              "video": {"w": 640, "h": 360, "mimes": ["video/mp4"]},
              "ext": {"bidder": {"sspId": "prebid"}}
            },
            {
              "id": "native-imp",
              "native": {"request": "{\"ver\":\"1.2\",\"assets\":[{\"id\":1,\"required\":1,\"title\":{\"len\":90}}]}", "ver": "1.2"},
              "ext": {"bidder": {"sspId": "prebid"}}
            }
          ]
        },
        "impIDs": ["video-imp", "native-imp"]
      },
      "mockResponse": {
        "status": 200,
        "body": {
          "id": "test-request-id",
          "seatbid": [
