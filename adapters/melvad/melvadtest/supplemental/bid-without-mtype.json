                },
                {
                  "id": "bid-native",
                  "impid": "native-imp",
                  "price": 1,
                  "adm": "{\"native\":{\"ver\":\"1.2\",\"assets\":[{\"id\":1,\"title\":{\"text\":\"Ad\"}}]}}",
                  "crid": "crid-native"
                }
              ],
              "seat": "melvad"
