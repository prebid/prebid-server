                {
                  "id": "bid-3",
                  "impid": "imp-banner",
                  "price": 1,
                  "adm": "{\"native\":{}}",
                  "crid": "crid-3",
                  "mtype": 4
                }
              ]
            }
          ]
        }
      }
    }
