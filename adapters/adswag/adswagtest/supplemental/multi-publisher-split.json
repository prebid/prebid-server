    "id": "test-request-id",
    "imp": [
      {
        "id": "imp-pub-a",
        "banner": { "format": [{ "w": 300, "h": 250 }] },
        "ext": { "bidder": { "publisherId": "pub-a" } }
      },
      {
        "id": "imp-pub-b",
        "banner": { "format": [{ "w": 728, "h": 90 }] },
        "ext": { "bidder": { "publisherId": "pub-b" } }
      },
      {
        "id": "imp-pub-a-2",
        "banner": { "format": [{ "w": 160, "h": 600 }] },
        "ext": { "bidder": { "publisherId": "pub-a" } }
      }
    ],
    "site": {
      "domain": "example.nl",
      "page": "https://example.nl/"
