              ]
            }
          ]
        }
      }
    },
    {
      "expectedRequest": {
        "uri": "https://test.endpoint.example/prebid/bid",
        "body": {
          "id": "test-request-id",
          "imp": [
            {
              "id": "imp-pub-b",
              "banner": { "format": [{ "w": 728, "h": 90 }] }
