          ],
          "site": {
            "domain": "example.nl",
            "page": "https://example.nl/",
            "publisher": { "id": "pub-b" }
          }
        },
        "impIDs": ["imp-pub-b"]
      },
      "mockResponse": {
        "status": 200,
        "body": {
          "id": "test-request-id",
          "cur": "EUR",
          "seatbid": [
            {
              "seat": "adswag",
